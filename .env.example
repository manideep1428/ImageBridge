# ================================================================
# Server & Port Configuration
# ================================================================
# Port on which the Express API server listens (Default: 3001)
PORT=3001

# Public or base URL used to construct local image asset URLs
SERVER_BASE_URL=http://localhost:3001

# ================================================================
# Storage Configuration (Local, Bunny CDN, or Both)
# ================================================================
# Options:
#   'local' - Saves images directly to local disk in OUTPUT_DIR and serves via HTTP route
#   'bunny' - Directly uploads generated images to Bunny Storage edge network
#   'both'  - Saves locally on server disk AND uploads to Bunny CDN simultaneously (Default)
STORAGE_MODE=both

# Local directory where generated images and try-on looks are saved
OUTPUT_DIR=./outputs

# ================================================================
# AI Provider & Model Configuration
# ================================================================
# AI Provider: 'chatgpt' or 'gemini' (Default: chatgpt)
AI_PROVIDER=chatgpt

# ChatGPT Browser Profile Directory & URL (Session created automatically on login)
CHATGPT_PROFILE_DIR=./chatgpt-profile
CHATGPT_URL=https://chatgpt.com

# Gemini Browser Profile Directory & URL (Session created automatically on login)
GEMINI_PROFILE_DIR=./gemini-profile
GEMINI_URL=https://gemini.google.com

# ================================================================
# Playwright Browser Automation Options
# ================================================================
# Run browser in background without visible window (Set to true for Linux VPS / Server)
HEADLESS=false

# Generation timeout in milliseconds (Default: 600000 = 10 minutes)
GENERATION_TIMEOUT_MS=600000

# Number of retry attempts on transient generation failures
MAX_RETRIES=2

# ================================================================
# Bunny.net Storage & CDN Configuration
# ================================================================
# Your Bunny Storage Zone name
BUNNY_STORAGE_ZONE=your-storage-zone-name

# Your Bunny Storage Zone Password (API Access Key from Bunny dashboard)
BUNNY_STORAGE_PASSWORD=your_bunny_storage_password

# Your Bunny Pull Zone CDN Hostname (e.g., https://myzone.b-cdn.net)
BUNNY_CDN_URL=https://your-pull-zone.b-cdn.net

# Bunny Storage Region Endpoint (Default: storage.bunnycdn.com)
BUNNY_STORAGE_REGION_HOST=storage.bunnycdn.com

# ================================================================
# Optional: Instagram Graph API (For automated posting)
# ================================================================
INSTAGRAM_ACCESS_TOKEN=your_instagram_graph_api_access_token
INSTAGRAM_USERNAME=your_instagram_username

